rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isParentOf(childId) {
      return signedIn() && get(/databases/$(database)/documents/users/$(childId)).data.parentId == request.auth.uid;
    }

    function isParent() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'parent';
    }

    match /users/{userId} {
      allow read: if signedIn() && (userId == request.auth.uid || resource.data.parentId == request.auth.uid);
      allow create: if signedIn() && userId == request.auth.uid;
      allow update: if signedIn() && userId == request.auth.uid;
    }

    match /locations/{id} {
      allow read: if isParentOf(resource.data.childId) || (signedIn() && resource.data.childId == request.auth.uid);
      allow create: if signedIn() && (request.resource.data.childId == request.auth.uid || isParentOf(request.resource.data.childId));
    }

    match /screen_time_records/{id} {
      allow read: if isParentOf(resource.data.childId) || (signedIn() && resource.data.childId == request.auth.uid);
      allow create: if signedIn() && (request.resource.data.childId == request.auth.uid || isParentOf(request.resource.data.childId));
    }

    match /activities/{id} {
      allow read, update: if signedIn() && resource.data.parentId == request.auth.uid;
      allow create: if signedIn() && (request.resource.data.childId == request.auth.uid || request.resource.data.parentId == request.auth.uid);
    }

    match /app_rules/{id} {
      allow read, delete: if isParentOf(resource.data.childId);
      allow create, update: if isParentOf(request.resource.data.childId);
    }

    match /web_filters/{id} {
      allow read: if isParentOf(resource.data.childId);
      allow create, update: if isParentOf(request.resource.data.childId);
    }

    match /content_filter_configs/{id} {
      allow read: if isParentOf(resource.data.childId);
      allow create, update: if isParentOf(request.resource.data.childId);
    }

    match /blocked_content_logs/{id} {
      allow read: if isParentOf(resource.data.childId) || (signedIn() && resource.data.childId == request.auth.uid);
      allow create: if signedIn() && (request.resource.data.childId == request.auth.uid || isParentOf(request.resource.data.childId));
    }

    match /geofences/{id} {
      allow read: if isParentOf(resource.data.childId);
      allow create, update: if isParentOf(request.resource.data.childId);
    }
  }
}
